{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "869e4963cd01ed62c90a893d548c2273aeda0141",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "This PR was generated by release-please. Merging it tags the release and starts the build.",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "mollygram",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "yaml",
          "path": "packages/app/pubspec.yaml",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
